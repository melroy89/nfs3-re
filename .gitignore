# Track only the two modified v1.6.2 files; other game assets remain local.
/nfs3_decomp.rep/Electronic Arts/*
!/nfs3_decomp.rep/Electronic Arts/Need For Speed III/
/nfs3_decomp.rep/Electronic Arts/Need For Speed III/*
!/nfs3_decomp.rep/Electronic Arts/Need For Speed III/nfs3.exe
!/nfs3_decomp.rep/Electronic Arts/Need For Speed III/FEDATA/
/nfs3_decomp.rep/Electronic Arts/Need For Speed III/FEDATA/*
!/nfs3_decomp.rep/Electronic Arts/Need For Speed III/FEDATA/MENUS/
/nfs3_decomp.rep/Electronic Arts/Need For Speed III/FEDATA/MENUS/*
!/nfs3_decomp.rep/Electronic Arts/Need For Speed III/FEDATA/MENUS/setup.mnu

# Per-user Ghidra workspace and window/tool state.
/nfs3_decomp.rep/user/
/nfs3_decomp.rep/projectState

# Ghidra locks, temporary database files, and recovery backups.
*.lock
*.lock~
**/tmp*.ps
**/~index.bak
**/~journal.bak

# Editor and OS temporary files.
*~
*.swp
*.swo
.DS_Store
Thumbs.db
__pycache__/
*.pyc

# Keep nfs3_decomp.gpr and the shared files under nfs3_decomp.rep/:
# project.prp, idata/ (including ~index.dat and db.*.gbf), and versioned/.

# Local raw captures and generated exports; keep curated analysis evidence tracked.
/analysis/captures/
/analysis/exports/
/analysis/tmp/
/analysis/runtime/*.jsonl
/analysis/runtime/*.dmp
/analysis/runtime/*.dump
/analysis/runtime/*.raw
